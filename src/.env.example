# 复制为 .env.local，填入腾讯云密钥；仅服务端读取，禁止放进 dist。
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# 可选：临时凭证的 Token
TENCENTCLOUD_TOKEN=
# 调查模型：OpenAI 兼容服务地址（包含 /v1）、密钥及模型名；仅服务端读取。
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=MiniMax-M3
# 仅监听 127.0.0.1；未配置公网地址且非 production 时，重复启动会停止占用此端口的进程。
PORT=4173
# 公网部署时填写完整访问地址（如 https://game.example.com 或 http://203.0.113.10:8080）。
# 反向代理须保留外部 Host。留空仅允许本机访问；配置后不再自动抢占端口。
PUBLIC_ORIGIN=
